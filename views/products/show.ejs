<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.title %> - Campus Store</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: sans-serif;
      max-width: 850px;
      margin: 40px auto;
      padding: 0 20px;
      background: #f5f6fa;
      color: #222;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 24px;
    }

    .card {
      background: white;
      padding: 28px;
      border-radius: 10px;
      overflow-wrap: anywhere;
    }

    .product-image {
      display: block;
      max-width: 100%;
      max-height: 400px;
      object-fit: contain;
      margin: 20px 0;
      border-radius: 8px;
    }

    .price {
      font-size: 28px;
      color: #3159d9;
      font-weight: bold;
    }

    .description {
      white-space: pre-wrap;
      line-height: 1.6;
    }

    .seller {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid #ddd;
    }

    .muted {
      color: #666;
    }

    .actions {
      display: flex;
      gap: 12px;
      align-items: center;
      margin: 22px 0;
      flex-wrap: wrap;
    }

    .btn {
      border: none;
      border-radius: 8px;
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      background: #f0f2f6;
      color: #52627a;
    }

    .btn:hover {
      background: #e4e8ef;
    }

    .btn-primary {
      background: #3978db;
      color: white;
    }

    .btn-primary:hover {
      background: #2865c4;
    }
  </style>
</head>

<body>
  <nav>
    <a href="/products">Back to Products</a>

    <% if (currentUser) { %>
      <a href="/products/new">Publish a Product</a>
      <a href="/profile">Personal Information</a>
    <% } else { %>
      <a href="/login">Login</a>
    <% } %>
  </nav>

  <main class="card">
    <h1><%= product.title %></h1>

    <p class="price">¥<%= Number(product.price).toFixed(2) %></p>

    <p>
      <strong>Category:</strong>
      <%= product.category %>
    </p>

    <p>
      <strong>Status:</strong>
      <%= product.status === 'sold' ? 'Sold' : 'Available' %>
    </p>

    <div class="actions">
      <% if (product.status === 'available' && String(product.seller) !== String(currentUser._id)) { %>
        <form action="/cart/add/<%= product._id %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <button type="submit" class="btn btn-primary">
            🛒 Add to Cart
          </button>
        </form>
        <% } %>

      <form action="/favourites/toggle" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= product._id %>">
        <input type="hidden" name="back" value="/products/<%= product._id %>">

        <button type="submit" class="btn">
          <% if (typeof favouritedIds !== 'undefined' && favouritedIds.includes(String(product._id))) { %>
            ★ Unfavourite
          <% } else { %>
            ☆ Favourite
          <% } %>
        </button>
      </form>
    </div>

    <% if (imageUrl) { %>
      <img
        class="product-image"
        src="<%= imageUrl %>"
        alt="<%= product.title %>"
        referrerpolicy="no-referrer"
      >
    <% } else { %>
      <p class="muted">No image provided.</p>
    <% } %>

    <h2>Description</h2>
    <p class="description"><%= product.description %></p>

    <section class="seller">
      <h2>Seller Information</h2>

      <% if (product.seller) { %>
        <p>
          <strong>Seller:</strong>
          <%= product.seller.nickname %>
        </p>

        <% if (currentUser) { %>
          <p>
            <strong>Contact:</strong>
            <%= product.seller.contact || 'Not provided' %>
          </p>
        <% } else { %>
          <p>
            <a href="/login">Log in</a> to view seller contact information.
          </p>
        <% } %>

      <% } else { %>
        <p class="muted">Seller information is unavailable.</p>
      <% } %>
    </section>
  </main>
</body>
</html>