<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>products - Campus Store</title>
  <style>
    body {
      font-family: sans-serif;
      max-width: 960px;
      margin: 40px auto;
      padding: 0 20px;
      background: #f5f6fa;
      color: #222;
    }

    nav {
      display: flex;
      gap: 20px;
      margin-bottom: 24px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }

    th,
    td {
      padding: 14px;
      border-bottom: 1px solid #ddd;
      text-align: left;
      overflow-wrap: anywhere;
    }

    .empty {
      padding: 30px;
      background: white;
      border-radius: 8px;
    }
  .search-form {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 12px;
  padding: 16px;
  margin: 20px 0;
  background: white;
  border-radius: 8px;
}

.search-form label {
  display: block;
  margin-bottom: 6px;
}

.search-form input,
.search-form select,
.search-form button {
  padding: 9px 12px;
  font: inherit;
}

.search-form > a {
  padding: 9px 0;
}






</style>
</head>

<body>
  <nav>
    <a href="/">home</a>

    <% if (currentUser) { %>
      <a href="/profile">personal information</a>
      <% } else { %>
        <a href="/login">login</a>
        <a href="/register">register</a>
        <% } %>
  </nav>

  <h1>products</h1>
  <% if (currentUser) { %>
    <p>
      <a href="/products/new">Publish a Product</a>
      |
      <a href="/products/mine">My Products</a>
    </p>
    <% } else { %>
      <p><a href="/login">Log in to publish a product</a></p>
      <% } %>
        <form action="/products" method="GET" class="search-form">
  <div>
    <label for="q">Product name</label>
    <input
      type="search"
      id="q"
      name="q"
      value="<%= q %>"
      maxlength="100"
      placeholder="Search by product name"
    >
  </div>

  <div>
    <label for="category">Category</label>
    <select id="category" name="category">
      <option value="">All categories</option>

      <% categories.forEach(category => { %>
        <option
          value="<%= category %>"
          <%= selectedCategory === category ? 'selected' : '' %>
        >
          <%= category %>
        </option>
      <% }); %>
    </select>
  </div>

  <button type="submit">Search</button>
  <a href="/products">Reset</a>
</form>

<p>
  Showing <%= products.length %> products
  (up to 50, newest first).
</p>

        <% if (products.length===0) { %>
          <div class="empty">
  <% if (q || selectedCategory) { %>
    No products match your search. Try another keyword or category.
    <a href="/products">Clear filters</a>
  <% } else { %>
    No products are available yet. Once the first product is published,
    it will appear here.
  <% } %>
</div>
          <% } else { %>
            <table>
              <thead>
                <tr>
                  <th>product name</th>
                  <th>category</th>
                  <th>price</th>
                  <th>status</th>
                  <th>action</th>
                  <th>favourite</th>
                </tr>
              </thead>

              <tbody>
                <% products.forEach(product=> { %>
                  <tr>
                    <td>
                      <a href="/products/<%= product._id %>">
                        <%= product.title %>
                      </a>
                    </td>

                    <td>
                      <%= product.category %>
                    </td>

                    <td>
                      ¥<%= Number(product.price).toFixed(2) %>
                    </td>

                    <td>
                      <%= product.status==='sold' ? 'sold' : 'available' %>
                    </td>

                    <td>
                      <% if (!currentUser) { %>

                        <a href="/login">Login to Add</a>

                        <% } else if (product.status==='sold' ) { %>

                          <span style="color: gray;">Sold Out</span>

                          <% } else if ( String(product.seller)===String(currentUser._id) ) { %>

                            <span style="color: gray;">Your Listing</span>

                            <% } else { %>

                              <form action="/cart/add/<%= product._id %>" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <button type="submit">
                                  🛒 Add to Cart
                                </button>
                              </form>

                              <% } %>
                    </td>

                    <td>
                      <% if (!currentUser) { %>

                        <a href="/login">Login to Save</a>

                        <% } else { %>

                          <form action="/favourites/toggle" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <input type="hidden" name="back" value="/products">

                            <button type="submit">
                              <% if (typeof favouritedIds !== 'undefined' && favouritedIds.includes(String(product._id))) { %>
                                ★ Unfavourite
                              <% } else { %>
                                ☆ Favourite
                              <% } %>
                            </button>
                          </form>

                          <% } %>
                    </td>
                  </tr>
                  <% }); %>
              </tbody>

            </table>
            <% } %>
</body>

</html>
