<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Products - Campus Store</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: sans-serif;
      max-width: 960px;
      margin: 40px auto;
      padding: 0 20px;
      background: #f5f6fa;
      color: #222;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 24px;
    }

    .button {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 6px;
      background: #4f73ef;
      color: white;
      text-decoration: none;
    }

    .empty {
      margin-top: 24px;
      padding: 30px;
      background: white;
      border-radius: 8px;
    }

    .table-wrapper {
      margin-top: 24px;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }

    th, td {
      padding: 14px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }

    .product-name {
      overflow-wrap: anywhere;
    }

    .status {
      white-space: nowrap;
    }
  .actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.delete-form {
  margin: 0;
}

.delete-button {
  padding: 8px 12px;
  border: 0;
  border-radius: 6px;
  background: #c62828;
  color: white;
  font: inherit;
  cursor: pointer;
}

.delete-button:hover {
  background: #a51f1f;
}
  
  
  
  </style>
</head>

<body>
  <nav>
    <a href="/">Home</a>
    <a href="/products">All Products</a>
    <a href="/profile">Personal Information</a>
  </nav>

  <h1>My Products</h1>
  <p>Manage the products you have published.</p>

  <a class="button" href="/products/new">Publish a Product</a>

  <% if (products.length === 0) { %>
    <div class="empty">
      You have not published any products yet.
    </div>
  <% } else { %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price (CNY)</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <td class="product-name">
                <a href="/products/<%= product._id %>">
                  <%= product.title %>
                </a>
              </td>

              <td><%= product.category %></td>

              <td>
                ¥<%= Number(product.price).toFixed(2) %>
              </td>

              <td class="status">
                <%= product.status === 'sold' ? 'Sold' : 'Available' %>
              </td>

              <td>
  <div class="actions">
    <a href="/products/<%= product._id %>">View</a>

    <a href="/products/<%= product._id %>/edit">Edit</a>

    <form
      class="delete-form"
      action="/products/<%= product._id %>/delete"
      method="POST"
      onsubmit="return confirm('Delete this product permanently? This cannot be undone.');"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <button class="delete-button" type="submit">
        Deletes
      </button>
    </form>
  </div>
</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</body>
</html>