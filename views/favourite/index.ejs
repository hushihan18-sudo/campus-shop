<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Favourites | Campus Shop</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #202b3c;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .navbar {
            height: 72px;
            background: white;
            border-bottom: 1px solid #e8edf3;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 7%;
        }

        .logo {
            font-size: 23px;
            font-weight: 800;
            color: #243b65;
        }

        .logo span {
            color: #3978db;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
            font-size: 14px;
        }

        .nav-links a {
            color: #697586;
        }

        .nav-links a:hover,
        .nav-links .active {
            color: #3978db;
            font-weight: 700;
        }

        .container {
            max-width: 1120px;
            margin: 55px auto;
            padding: 0 24px;
        }

        .heading {
            margin-bottom: 30px;
        }

        .heading h1 {
            font-size: 32px;
            margin-bottom: 9px;
        }

        .heading p {
            color: #8490a0;
            font-size: 14px;
        }

        .alert {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .success {
            background: #eaf8f0;
            color: #207849;
        }

        .error {
            background: #fff0f0;
            color: #bd3d3d;
        }

        .favourite-panel {
            background: white;
            border-radius: 12px;
            border: 1px solid #e9edf3;
            padding: 25px;
        }

        .panel-title {
            font-size: 19px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 14px;
            padding-bottom: 20px;
            margin-bottom: 4px;
            border-bottom: 1px solid #edf0f4;
            flex-wrap: wrap;
        }

        .toolbar .hint {
            font-size: 13px;
            color: #8490a0;
            margin-right: auto;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 11px 20px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            background: #f0f2f6;
            color: #52627a;
        }

        .btn:hover {
            background: #e4e8ef;
        }

        .btn-danger {
            background: #d65a5a;
            color: white;
        }

        .btn-danger:hover {
            background: #bf4848;
        }

        .btn-primary {
            background: #3978db;
            color: white;
        }

        .btn-primary:hover {
            background: #2865c4;
        }

        .item {
            display: grid;
            grid-template-columns: 32px 115px 1fr auto;
            gap: 20px;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #edf0f4;
        }

        .item select {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .item-image {
            width: 115px;
            height: 105px;
            object-fit: cover;
            border-radius: 9px;
            background: #f0f2f6;
        }

        .placeholder {
            width: 115px;
            height: 105px;
            border-radius: 9px;
            background: #f0f2f6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #98a3b3;
            font-size: 12px;
        }

        .item-info h3 {
            font-size: 16px;
            margin-bottom: 9px;
        }

        .item-info p {
            font-size: 13px;
            color: #8490a0;
            margin-bottom: 8px;
        }

        .price {
            font-size: 17px;
            font-weight: 700;
            color: #263e67;
        }

        .sold {
            color: #bd3d3d;
            font-weight: 700;
        }

        .removed {
            color: #8490a0;
            font-weight: 700;
        }

        .item-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .remove-btn {
            border: none;
            background: transparent;
            color: #d65a5a;
            cursor: pointer;
            font-size: 13px;
            padding: 8px;
        }

        .remove-btn:hover {
            text-decoration: underline;
        }

        .continue {
            display: block;
            text-align: center;
            color: #3978db;
            font-size: 14px;
            margin-top: 22px;
        }

        .empty {
            text-align: center;
            padding: 65px 20px;
        }

        .empty-icon {
            font-size: 55px;
            margin-bottom: 20px;
        }

        .empty h2 {
            font-size: 22px;
            margin-bottom: 12px;
        }

        .empty p {
            color: #8792a2;
            margin-bottom: 25px;
        }

        .shop-btn {
            display: inline-block;
            background: #3978db;
            color: white;
            padding: 13px 25px;
            border-radius: 8px;
            font-size: 14px;
        }

        @media (max-width: 760px) {
            .navbar {
                padding: 0 20px;
            }

            .nav-links {
                gap: 13px;
                font-size: 12px;
            }

            .item {
                grid-template-columns: 26px 85px 1fr;
                gap: 12px;
            }

            .item-image,
            .placeholder {
                width: 85px;
                height: 85px;
            }

            .item-actions {
                grid-column: 3;
                margin-top: 10px;
            }

            .container {
                margin-top: 35px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <header class="navbar">
        <a href="/" class="logo">
            Campus<span>Shop</span>
        </a>

        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/products">Products</a>
            <a href="/cart">Cart</a>
            <a href="/favourites" class="active">Favourites</a>
            <a href="/profile">Profile</a>
        </nav>
    </header>

    <main class="container">

        <div class="heading">
            <h1>My Favourites</h1>
            <p>Products you saved for later. Tick the products you want to remove.</p>
        </div>

        <% if (notice) { %>
            <div class="alert success">
                <%= notice %>
            </div>
            <% } %>

                <% if (error) { %>
                    <div class="alert error">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (items.length===0) { %>

                            <!-- Empty Favourite List -->
                            <section class="favourite-panel empty">
                                <div class="empty-icon">⭐</div>
                                <h2>No favourites yet</h2>
                                <p>You haven't saved any products yet.</p>
                                <a href="/products" class="shop-btn">
                                    Browse Products
                                </a>
                            </section>

                            <% } else { %>

                                <section class="favourite-panel">

                                    <div class="panel-title">
                                        Saved Products (<%= count %>)
                                    </div>

                                    <!-- Batch delete form, the ticked checkboxes point back to it -->
                                    <form action="/favourites/remove-batch" method="POST" id="favourite-batch-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                        <div class="toolbar">
                                            <span class="hint">
                                                <%= count %> product<%= count === 1 ? '' : 's' %> saved
                                            </span>

                                            <button type="submit" class="btn btn-danger">
                                                Remove Selected
                                            </button>
                                        </div>
                                    </form>

                                    <% items.forEach(function(item) { %>

                                        <article class="item">

                                            <!-- Tick box for the batch delete -->
                                            <input type="checkbox" name="productIds" value="<%= item.productId %>"
                                                form="favourite-batch-form">

                                            <div>
                                                <% if (item.imageUrl) { %>
                                                    <img src="<%= item.imageUrl %>" alt="<%= item.title %>"
                                                        class="item-image"
                                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                    <div class="placeholder" style="display:none;">
                                                        No Image
                                                    </div>
                                                    <% } else { %>
                                                        <div class="placeholder">No Image</div>
                                                        <% } %>
                                            </div>

                                            <div class="item-info">
                                                <h3>
                                                    <a href="/products/<%= item.productId %>">
                                                        <%= item.title %>
                                                    </a>
                                                </h3>

                                                <p>
                                                    <%= item.category || 'Uncategorised' %>
                                                </p>

                                                <div class="price">
                                                    ¥<%= Number(item.price).toFixed(2) %>
                                                </div>

                                                <% if (item.status === 'sold') { %>
                                                    <p class="sold">
                                                        Sold
                                                    </p>
                                                    <% } else if (item.status === 'removed') { %>
                                                        <p class="removed">
                                                            No longer exists
                                                        </p>
                                                        <% } %>
                                            </div>

                                            <div class="item-actions">

                                                <% if (item.available) { %>
                                                    <form action="/cart/add/<%= item.productId %>" method="POST">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                        <button type="submit" class="btn btn-primary">
                                                            Add to Cart
                                                        </button>
                                                    </form>
                                                    <% } %>

                                                <form action="/favourites/remove" method="POST">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <input type="hidden" name="productId" value="<%= item.productId %>">

                                                    <button type="submit" class="remove-btn">
                                                        Remove
                                                    </button>
                                                </form>

                                            </div>

                                        </article>

                                        <% }); %>

                                            <a href="/products" class="continue">
                                                ← Continue Browsing
                                            </a>

                                </section>

                                <% } %>

    </main>

</body>

</html>
