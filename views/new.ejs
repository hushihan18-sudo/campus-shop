<% const isEditing = typeof editProductId !== 'undefined' && Boolean(editProductId); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEditing ? 'Edit Product' : 'Publish Product' %> - Campus Store</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: sans-serif;
      max-width: 760px;
      margin: 40px auto;
      padding: 0 20px;
      background: #f5f6fa;
      color: #222;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 24px;
    }

    form {
      padding: 24px;
      background: white;
      border-radius: 10px;
    }

    label {
      display: block;
      margin-top: 18px;
      margin-bottom: 8px;
      font-weight: bold;
    }

    input, textarea, select {
      width: 100%;
      padding: 12px;
      border: 1px solid #bbb;
      border-radius: 6px;
      font: inherit;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    button {
      margin-top: 24px;
      padding: 12px 24px;
      border: 0;
      border-radius: 6px;
      background: #4f73ef;
      color: white;
      font: inherit;
      cursor: pointer;
    }

    .error {
      padding: 14px;
      background: #fee;
      color: #a00;
      border-radius: 6px;
    }

    .hint {
      color: #555;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <nav>
    <a href="/products">Products</a>
    <a href="/profile">Personal Information</a>
  </nav>

 <h1><%= isEditing ? 'Edit Product' : 'Publish a Product' %></h1>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form
  action="<%= isEditing ? '/products/' + editProductId + '/edit' : '/products' %>"
  method="POST"
>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="title">Product Name</label>
    <input
      id="title"
      name="title"
      type="text"
      maxlength="100"
      value="<%= values.title || '' %>"
      required
    >

    <label for="description">Description</label>
    <textarea
      id="description"
      name="description"
      maxlength="3000"
      required
    ><%= values.description || '' %></textarea>

    <label for="price">Price (CNY)</label>
    <input
      id="price"
      name="price"
      type="number"
      min="0"
      max="1000000"
      step="0.01"
      value="<%= values.price ?? '' %>"
      required
    >

    <label for="category">Category</label>
    <select id="category" name="category" required>
      <option value="">Select a category</option>

      <% categories.forEach(category => { %>
        <option
          value="<%= category %>"
          <%= values.category === category ? 'selected' : '' %>
        ><%= category %></option>
      <% }); %>
    </select>

    <label for="imageUrl">Image URL (optional)</label>
    <input
      id="imageUrl"
      name="imageUrl"
      type="url"
      maxlength="2048"
      placeholder="https://example.com/product.jpg"
      value="<%= values.imageUrl || '' %>"
    >
    <p class="hint">
      Enter an HTTP or HTTPS image URL, or leave this field blank.
    </p>

   <% if (isEditing) { %>
  <label for="status">Status</label>
  <select id="status" name="status" required>
    <option
      value="available"
      <%= values.status === 'available' ? 'selected' : '' %>
    >Available</option>

    <option
      value="sold"
      <%= values.status === 'sold' ? 'selected' : '' %>
    >Sold</option>
  </select>
<% } %>

<button type="submit">
  <%= isEditing ? 'Save Changes' : 'Publish Product' %>
</button>

<p>
  <a href="<%= isEditing ? '/products/mine' : '/products' %>">Cancel</a>
</p>
</body>
</html>