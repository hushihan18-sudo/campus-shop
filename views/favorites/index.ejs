<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Favorites - Campus Store</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: sans-serif;
      max-width: 960px;
      margin: 40px auto;
      padding: 0 20px;
      background: #f5f6fa;
      color: #222;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 24px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }

    th, td {
      padding: 14px;
      border-bottom: 1px solid #ddd;
      text-align: left;
      overflow-wrap: anywhere;
    }

    .thumb {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: 6px;
    }

    .price {
      color: #3159d9;
      font-weight: bold;
    }

    button {
      padding: 8px 14px;
      border: 1px solid #b3261e;
      background: white;
      color: #b3261e;
      border-radius: 6px;
      cursor: pointer;
    }

    .warning {
      color: #b3261e;
      font-size: 13px;
    }

    .empty {
      padding: 30px;
      background: white;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <nav>
    <a href="/">home</a>
    <a href="/products">products</a>
    <a href="/cart">shopping cart</a>
    <a href="/profile">personal information</a>
    <a href="/logout">logout</a>
  </nav>

  <h1>my favorites</h1>

  <% if (rows.length === 0) { %>
    <div class="empty">
      You have not favorited any product yet.
      <a href="/products">Browse products</a> and click the favorite button.
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>image</th>
          <th>product name</th>
          <th>price</th>
          <th>status</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% rows.forEach(product => { %>
          <tr>
            <td>
              <% if (product.imageUrl) { %>
                <img
                  class="thumb"
                  src="<%= product.imageUrl %>"
                  alt="<%= product.title %>"
                  referrerpolicy="no-referrer"
                >
              <% } else { %>
                <span class="muted">no image</span>
              <% } %>
            </td>

            <td>
              <a href="/products/<%= product._id %>">
                <%= product.title %>
              </a>
            </td>

            <td class="price">¥<%= Number(product.price).toFixed(2) %></td>

            <td>
              <% if (product.status === 'sold') { %>
                <span class="warning">Sold</span>
              <% } else { %>
                available
              <% } %>
            </td>

            <td>
              <form action="/favorites/toggle" method="POST">
                <input
                  type="hidden"
                  name="_csrf"
                  value="<%= csrfToken %>"
                >
                <input
                  type="hidden"
                  name="productId"
                  value="<%= product._id %>"
                >
                <input
                  type="hidden"
                  name="back"
                  value="/favorites"
                >
                <button type="submit">Remove</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
