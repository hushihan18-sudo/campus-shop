<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Campus Store - Login</title>
  <style>
    body { font-family: sans-serif; background-color: #f8f9fa; }
    .container { max-width: 400px; margin: 50px auto; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    label { display: block; margin-top: 10px; }
    input { width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
    button { margin-top: 15px; width: 100%; padding: 10px; background: #007bff; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    .msg { color: red; margin-bottom: 10px; }
    a { color: #007bff; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Campus Store - Login</h2>
    <% if (message) { %>
      <p class="msg"><%= message %></p>
    <% } %>
    <form action="/login" method="POST">
      <label>Email</label>
      <input type="email" name="email" required>

      <label>Password</label>
      <input type="password" name="password" required>

      <button type="submit">Login</button>
    </form>
    <p style="margin-top:10px;">Don't have an account? <a href="/register">Register</a></p>
  </div>
</body>
</html>